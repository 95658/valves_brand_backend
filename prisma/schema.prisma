datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  OWNER
  OPERATIONS
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum CodSettlementStatus {
  UNCOLLECTED
  WITH_COURIER
  SETTLED
}

enum StockMovementReason {
  ORDER_CONFIRMED
  ORDER_RETURNED
  ORDER_CANCELLED
  RESTOCK
  DAMAGED
  MANUAL_AUDIT
}

enum ExpenseCategory {
  META_ADS
  TIKTOK_ADS
  PACKAGING
  PRODUCTION
  SHIPPING_ADJUSTMENT
  STUDIO
  MISC
}

enum AnalyticsEventType {
  PAGE_VIEW
  PRODUCT_VIEW
  ADD_TO_BAG
  BEGIN_CHECKOUT
  PURCHASE
}

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         AdminRole      @default(OPERATIONS)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

model Product {
  id          String           @id @default(uuid())
  name        String
  nameAr      String?
  collection  String           // streetwear, casual, athleisure
  tag         String?          // e.g. "DROP 01 • HEAVYWEIGHT"
  description String
  details     Json?            // string array
  image       String
  gallery     Json?            // string array
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                String          @id @default(uuid())
  productId         String
  sku               String          @unique
  size              String          // S, M, L, XL, XXL, etc.
  color             String          // Obsidian Black, Titanium Charcoal, etc.
  fabricGsm         Int             @default(460) // 300, 460
  dropTag           String?         // DROP 01
  retailPriceEgp    Decimal         @db.Decimal(12, 2)
  unitCostEgp       Decimal         @db.Decimal(12, 2)
  stockQty          Int             @default(0)
  lowStockThreshold Int             @default(5)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  orderItems        OrderItem[]

  @@index([productId])
  @@index([stockQty])
  @@map("product_variants")
}

model StockMovement {
  id          String              @id @default(uuid())
  variantId   String
  changeQty   Int                 // positive (restock) or negative (deduct)
  reason      StockMovementReason
  orderId     String?
  adminUserId String?
  note        String?
  createdAt   DateTime            @default(now())

  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("stock_movements")
}

model Order {
  id                  String              @id @default(uuid())
  orderNumber         String              @unique // e.g. VLV-8921
  customerName        String
  customerPhone       String
  customerEmail       String?
  governorate         String              // Cairo, Giza, Alexandria, etc.
  city                String
  address             String
  notes               String?
  status              OrderStatus         @default(PENDING)
  paymentMethod       PaymentMethod       @default(COD)
  codSettlementStatus CodSettlementStatus @default(UNCOLLECTED)
  subtotalEgp         Decimal             @db.Decimal(12, 2)
  discountEgp         Decimal             @default(0) @db.Decimal(12, 2)
  shippingFeeEgp      Decimal             @default(0) @db.Decimal(12, 2)
  totalEgp            Decimal             @db.Decimal(12, 2)
  couponId            String?
  deliveredAt         DateTime?
  settledAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  items               OrderItem[]
  coupon              Coupon?             @relation(fields: [couponId], references: [id])

  @@index([status, createdAt])
  @@index([codSettlementStatus])
  @@map("orders")
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  variantId           String?
  productName         String
  size                String
  color               String
  quantity            Int
  unitPriceEgp        Decimal         @db.Decimal(12, 2)
  unitCostSnapshotEgp Decimal         @db.Decimal(12, 2)

  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Expense {
  id           String          @id @default(uuid())
  category     ExpenseCategory
  amountEgp    Decimal         @db.Decimal(12, 2)
  incurredDate DateTime        @db.Date
  notes        String?
  createdById  String?
  createdAt    DateTime        @default(now())

  @@index([incurredDate, category])
  @@map("expenses")
}

model AnalyticsEvent {
  id          String             @id @default(uuid())
  sessionId   String
  eventType   AnalyticsEventType
  pagePath    String
  productId   String?
  orderId     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?
  deviceType  String?
  metadata    Json?
  createdAt   DateTime           @default(now())

  @@index([eventType, createdAt])
  @@index([productId, eventType, createdAt])
  @@index([utmSource, createdAt])
  @@map("analytics_events")
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?      // e.g. 10 for 10%
  discountEgp     Decimal?  @db.Decimal(12, 2)
  minOrderEgp     Decimal?  @db.Decimal(12, 2)
  usageLimit      Int?
  usageCount      Int       @default(0)
  expiresAt       DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  orders          Order[]

  @@map("coupons")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?  @default("STOREFRONT_FOOTER")
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model AdminAuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  action      String     // e.g. "UPDATE_ORDER_STATUS", "RESTOCK_SKU"
  targetType  String     // "ORDER", "VARIANT", "EXPENSE", etc.
  targetId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())

  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model StoreSettings {
  id                          String   @id @default("default")
  freeShippingThresholdEgp     Decimal  @default(2000.00) @db.Decimal(12, 2)
  standardShippingFeeEgp      Decimal  @default(75.00) @db.Decimal(12, 2)
  shippingRatesByGovernorate  Json?
  updatedAt                   DateTime @updatedAt

  @@map("store_settings")
}
